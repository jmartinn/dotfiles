// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "session": {
    "trust_all_worktrees": true
  },
  "auto_install_extensions": {
    "php": true,
    "blade": true,
    "laravel-official": true
  },
  "file_types": {
    "Blade": ["*.blade.php"]
  },
  "languages": {
    "PHP": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "zed-php-formatter",
          "arguments": ["{buffer_path}"]
        }
      },
      "language_servers": [
        "intelephense",
        "laravel",
        "tailwindcss-language-server",
        "!phpactor",
        "!phptools",
        "!phpantom",
        "..."
      ]
    },
    "Blade": {
      "tab_size": 4,
      "hard_tabs": false,
      "language_servers": [
        "intelephense",
        "laravel",
        "tailwindcss-language-server",
        "!phpactor",
        "!phptools",
        "!phpantom",
        "..."
      ]
    }
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "php": "html",
          "blade": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class=\\\"([^\\\"]*)\\\"",
            "@class\\(\\[([^\\]]*)\\]\\)"
          ]
        }
      }
    }
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "acceptEdits",
        "model": "default"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "restore_on_startup": "none",
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "current_line_highlight": "line"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  }
}
