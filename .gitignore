.env
.DS_Store
nvim.log
.lazy-lock.json
**/tmux/plugins
.config/github-copilot/

# Zed - ignore everything except settings
.config/zed/*
!.config/zed/settings.json

# Tool-managed dirs (auto-generated runtime/cache, not real dotfiles)
.config/btop/
.config/composer/
.config/fish/
.config/htop/
.config/gh/
.config/herd-lite/
.config/intelephense/
.config/mole/
.config/opencode/
.config/psysh/
.config/vercel-plugin/

# Herdr: keep durable config and host service; runtime state can contain secrets and machine IDs
.config/herdr/*
!.config/herdr/config.toml
!.config/herdr/com.jmartinn.herdr-server.plist
